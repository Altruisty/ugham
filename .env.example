# ========================================================
# UGHAM WEB APP CONFIGURATION
# ========================================================

# 1. Brevo SMTP Configuration (Authenticated domain: ugham.com)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=UGHAM Events
EMAIL_FROM_ADDRESS=events@ugham.com
EMAIL_REPLY_TO=admin@ugham.com

# 2. Database: Aiven PostgreSQL Connection URL (SSL enabled)
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:PORT/defaultdb?sslmode=require

# 3. Razorpay API Keys (Optional, fallback provided)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# 4. Admin Dashboard Access Passkey
ADMIN_PASSWORD=ugham@admin2026
